{
    "version": "1.0",
    "description": "Skill activation triggers for Claude Code. Controls when skills automatically suggest or block actions.",
    "skills": {
        "skill-developer": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "Meta-skill for creating and managing Claude Code skills",
            "promptTriggers": {
                "keywords": [
                    "skill system",
                    "create skill",
                    "add skill",
                    "skill triggers",
                    "skill rules",
                    "hook system",
                    "skill development",
                    "skill-rules.json"
                ],
                "intentPatterns": [
                    "(how do|how does|explain).*?skill",
                    "(create|add|modify|build).*?skill",
                    "skill.*?(work|trigger|activate|system)"
                ]
            }
        },
        "fastapi-backend-guidelines": {
            "type": "domain",
            "enforcement": "suggest",
            "priority": "high",
            "description": "FastAPI backend development patterns for Python async applications with SQLModel/SQLAlchemy, domain-driven design, and layered architecture",
            "promptTriggers": {
                "keywords": [
                    "backend",
                    "backend development",
                    "fastapi",
                    "FastAPI",
                    "service",
                    "repository",
                    "route",
                    "router",
                    "routing",
                    "API",
                    "endpoint",
                    "async",
                    "await",
                    "SQLModel",
                    "SQLAlchemy",
                    "database",
                    "orm",
                    "domain",
                    "dto",
                    "pydantic",
                    "validation",
                    "model",
                    "middleware"
                ],
                "intentPatterns": [
                    "(create|add|implement|build).*?(route|endpoint|API|router|service|repository)",
                    "(fix|handle|debug).*?(error|exception|backend)",
                    "(add|implement).*?(middleware|validation|error.*?handling)",
                    "(organize|structure|refactor).*?(backend|service|API|domain)",
                    "(how to|best practice).*?(backend|fastapi|route|router|service|repository)",
                    "(async|await).*?(pattern|function|method)",
                    "(database|orm|model).*?(query|create|update|delete)"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "backend/backend/**/*.py",
                    "backend/backend/api/**/*.py",
                    "backend/backend/domain/**/*.py",
                    "backend/backend/dtos/**/*.py"
                ],
                "pathExclusions": [
                    "**/__pycache__/**",
                    "**/*.pyc",
                    "**/test_*.py",
                    "**/*_test.py",
                    "**/conftest.py"
                ],
                "contentPatterns": [
                    "from fastapi import",
                    "@router\\.",
                    "async def",
                    "AsyncSession",
                    "SQLModel",
                    "BaseRepository",
                    "class.*Service:",
                    "class.*Repository:"
                ]
            }
        },
        "nextjs-frontend-guidelines": {
            "type": "guardrail",
            "enforcement": "block",
            "priority": "high",
            "description": "Next.js 15/React 19/TypeScript best practices including MUI v5 compatibility and App Router patterns",
            "promptTriggers": {
                "keywords": [
                    "component",
                    "react component",
                    "UI",
                    "interface",
                    "page",
                    "modal",
                    "dialog",
                    "form",
                    "MUI",
                    "Material-UI",
                    "Grid",
                    "styling",
                    "frontend",
                    "React",
                    "Next.js",
                    "nextjs",
                    "server component",
                    "client component",
                    "app router",
                    "use client"
                ],
                "intentPatterns": [
                    "(create|add|make|build|update|modify|edit).*?(component|UI|page|modal|dialog|form)",
                    "(how to|best practice).*?(component|react|MUI|nextjs|next.js)",
                    "(style|design|layout).*?(component|UI)",
                    "(server|client).*?component",
                    "app router"
                ]
            },
            "fileTriggers": {
                "pathPatterns": [
                    "frontend/src/**/*.tsx",
                    "frontend/src/**/*.ts",
                    "frontend/src/app/**/*.tsx",
                    "frontend/src/app/**/*.ts",
                    "frontend/src/components/**/*.tsx"
                ],
                "pathExclusions": [
                    "**/*.test.tsx",
                    "**/*.test.ts",
                    "**/*.spec.tsx",
                    "**/*.spec.ts",
                    "**/*.styles.ts",
                    "**/next.config.*",
                    "**/tsconfig.json"
                ],
                "contentPatterns": [
                    "from '@mui/material';",
                    "import.*Grid.*from.*@mui",
                    "<Grid ",
                    "'use client'",
                    "'use server'",
                    "export default async function",
                    "next/navigation",
                    "next/image"
                ]
            },
            "blockMessage": "⚠️ BLOCKED - Next.js Frontend Best Practices Required\n\n📋 REQUIRED ACTION:\n1. Use Skill tool: 'nextjs-frontend-guidelines'\n2. Review Next.js 15 App Router patterns (Server vs Client Components)\n3. Check MUI v5 patterns (Grid uses xs/sm props, NOT size={{}})\n4. Use proper styling patterns (MUI v5 + Tailwind CSS 4)\n5. Then retry this edit\n\nReason: Enforce Next.js 15 + MUI v5 compatibility and React best practices\nFile: {file_path}\n\n💡 TIP: Add '// @skip-validation' comment to skip future checks",
            "skipConditions": {
                "sessionSkillUsed": true,
                "fileMarkers": [
                    "@skip-validation"
                ],
                "envOverride": "SKIP_FRONTEND_GUIDELINES"
            }
        },
